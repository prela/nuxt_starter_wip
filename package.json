{
  "name": "nuxt-enterprise-starter",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "nuxt prepare && tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:coverage": "vitest run --coverage",
    "test": "pnpm test:unit && pnpm test:e2e && pnpm test:coverage",
    "ci:quality": "pnpm lint && pnpm type-check && pnpm test",
    "security:audit": "pnpm audit --audit-level high",
    "security:test": "playwright test tests/e2e/security/",
    "security:headers": "PORT=${PLAYWRIGHT_PORT:-3100} NODE_ENV=production JWT_SECRET=security-headers-jwt NUXT_CSRF_SECRET=security-headers-csrf pnpm -s preview --port $PORT --host 127.0.0.1 >/dev/null 2>&1 & PREVIEW_PID=$!; sleep 2; curl -sI http://127.0.0.1:$PORT | cat || true; kill $PREVIEW_PID || true",
    "security": "pnpm security:audit && pnpm security:test && pnpm security:headers"
  },
  "dependencies": {
    "@antfu/eslint-config": "^5.3.0",
    "@nuxt/content": "3.7.0",
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/eslint-config": "^1.9.0",
    "@nuxt/fonts": "0.11.4",
    "@nuxt/icon": "2.0.0",
    "@nuxt/image": "1.11.0",
    "@nuxt/scripts": "0.11.13",
    "@nuxt/ui": "4.0.0-alpha.1",
    "@pinia/nuxt": "^0.11.2",
    "@vueuse/nuxt": "^13.9.0",
    "better-sqlite3": "^12.2.0",
    "jsonwebtoken": "^9.0.2",
    "nuxt": "^4.1.2",
    "nuxt-security": "^2.4.0",
    "pinia": "^3.0.3",
    "typescript": "^5.9.2",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^3.19.2",
    "@playwright/test": "^1.55.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.35.0",
    "happy-dom": "^18.0.1",
    "playwright-core": "^1.55.0",
    "sharp": "^0.34.4",
    "vitest": "^3.2.4",
    "zod-to-json-schema": "^3.24.6"
  }
}
